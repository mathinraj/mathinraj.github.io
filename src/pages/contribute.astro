---
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import { person } from '../data/profile';

const qrOptions = {
  type: 'svg' as const,
  margin: 1,
  errorCorrectionLevel: 'M' as const,
  color: { dark: '#15171d', light: '#ffffff' },
};

const UPI_URI = 'upi://pay?pa=mathinraj@ptyes&pn=Mathinraj%20.';
const PAYPAL_URL = 'https://paypal.me/mathinraj';

const methods = [
  {
    id: 'paypal',
    name: 'PayPal',
    region: 'Worldwide',
    about: 'Cards or a PayPal balance, in your own currency.',
    label: 'PayPal link',
    handle: 'paypal.me/mathinraj',
    copyValue: PAYPAL_URL,
    openHref: PAYPAL_URL,
    openLabel: 'Open PayPal',
    mobileOnly: false,
    qr: await QRCode.toString(PAYPAL_URL, qrOptions),
  },
  {
    id: 'upi',
    name: 'UPI',
    region: 'India',
    about: 'GPay, PhonePe, Paytm, BHIM or any other UPI app.',
    label: 'UPI ID',
    handle: 'mathinraj@ptyes',
    copyValue: 'mathinraj@ptyes',
    openHref: UPI_URI,
    openLabel: 'Pay in a UPI app',
    mobileOnly: true,
    qr: await QRCode.toString(UPI_URI, qrOptions),
  },
];
---

<Layout
  title="Support the work, Mathinraj Ramasamy"
  description="TouchLock, RepoLens, Bing it and AutoPrompt are free. If one saved you time, you can support the work via PayPal or UPI."
  path="/contribute"
>
  <main class="support g-paper">
    <header class="support-bar wrap">
      <a class="text-link support-back" href="/">← {person.name}</a>
      <span class="mono">Support the work</span>
    </header>

    <section class="wrap support-intro">
      <h1 class="display support-title">Support the work.</h1>
      <p class="support-lede">
        TouchLock, RepoLens, Bing it and AutoPrompt are free to use. If one of them saved you time,
        a contribution pays for the hours that keep them maintained.
      </p>
    </section>

    <section class="wrap plates" aria-label="Ways to contribute">
      {methods.map((m) => (
        <article class="plate" data-method={m.id}>
          <header class="plate-head">
            <h2 class="display display--md">{m.name}</h2>
            <span class="mono">{m.region}</span>
          </header>
          <p class="plate-about">{m.about}</p>

          <button class="plate-toggle" type="button" aria-expanded="false" aria-controls={`panel-${m.id}`}>
            <span class="plate-toggle-label">Show QR code</span>
          </button>

          <div class="plate-panel" id={`panel-${m.id}`} hidden>
            <div class="qr" set:html={m.qr} role="img" aria-label={`QR code for ${m.name}: ${m.handle}`} />
            <div class="plate-detail">
              <p class="mono">{m.label}</p>
              <code class="plate-handle">{m.handle}</code>
              <p class="plate-actions">
                <button class="plate-btn copy-btn" type="button" data-copy={m.copyValue}>
                  <span class="copy-label">Copy</span>
                </button>
                <a
                  class:list={['plate-btn', 'plate-btn--quiet', { 'mobile-only': m.mobileOnly }]}
                  href={m.openHref}
                  target={m.mobileOnly ? undefined : '_blank'}
                  rel={m.mobileOnly ? undefined : 'noopener noreferrer'}
                >
                  {m.openLabel}
                </a>
              </p>
              {m.mobileOnly && <p class="plate-hint mono desktop-only">Scan with your phone’s UPI app.</p>}
            </div>
          </div>
        </article>
      ))}
    </section>

    <p class="wrap support-thanks">Thank you. Every contribution, of any size, is read and appreciated.</p>
    <p class="toast" role="status" aria-live="polite"></p>
  </main>
</Layout>

<style>
  .support { min-height: 100vh; min-height: 100svh; padding-bottom: var(--sc-9); }
  .support { --rail: 0px; }

  .support-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sc-4);
    padding-block: var(--sc-5);
    border-bottom: 1px solid var(--sc-hairline);
  }
  .support-back { font-weight: 500; text-decoration-color: transparent; }

  .support-intro { padding-block: clamp(3rem, 10vh, 7rem) var(--sc-8); }
  .support-title { font-size: clamp(3rem, 9vw, 8.5rem); letter-spacing: -0.05em; }
  .support-lede {
    margin: var(--sc-6) 0 0;
    max-width: 44ch;
    font-size: var(--sc-t-lg);
    line-height: 1.45;
    letter-spacing: var(--sc-track-snug);
    color: var(--sc-ink-soft);
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sc-6) clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .plate { padding-top: var(--sc-5); border-top: 2px solid var(--sc-ink); }
  .plate-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sc-4); }
  .plate-about { margin: var(--sc-3) 0 0; color: var(--sc-ink-soft); }

  .plate-toggle {
    margin-top: var(--sc-5);
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--sc-r-pill);
    background: var(--sc-ink);
    color: var(--paper);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--sc-d-fast) var(--sc-ease-out), transform 120ms var(--sc-ease-out);
  }
  .plate-toggle:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .plate-toggle:hover { background: var(--brand); }
  }
  .plate-toggle[aria-expanded='true'] { background: transparent; color: var(--sc-ink); box-shadow: inset 0 0 0 1px var(--sc-hairline-strong); }

  .plate-panel {
    display: grid;
    grid-template-columns: 184px minmax(0, 1fr);
    gap: var(--sc-5);
    align-items: start;
    margin-top: var(--sc-5);
  }
  .plate-panel[hidden] { display: none; }
  .plate-panel.is-opening { animation: wipe 280ms var(--sc-ease-out); }
  @keyframes wipe {
    from { clip-path: inset(0 0 100% 0); opacity: 0.4; }
    to { clip-path: inset(0 0 0 0); opacity: 1; }
  }
  .qr {
    padding: 10px;
    background: #fff;
    border-radius: var(--sc-r-md);
    box-shadow: var(--sc-edge), var(--sc-e2);
  }
  .qr :global(svg) { width: 100%; height: auto; }

  .plate-detail p.mono { margin: 4px 0 6px; }
  .plate-handle {
    display: block;
    font-family: var(--sc-font-mono);
    font-size: var(--sc-t-base);
    word-break: break-all;
  }
  .plate-actions { display: flex; flex-wrap: wrap; gap: var(--sc-3); margin: var(--sc-5) 0 0; }
  .plate-btn {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--sc-r-pill);
    background: var(--brand);
    color: #f4f5f0;
    font-size: var(--sc-t-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--sc-d-fast) var(--sc-ease-out), transform 120ms var(--sc-ease-out);
  }
  .plate-btn:active { transform: scale(0.97); }
  .plate-btn.is-copied { background: #1d7a46; }
  .plate-btn--quiet { background: transparent; color: var(--sc-ink); box-shadow: inset 0 0 0 1px var(--sc-hairline-strong); }
  .plate-hint { margin: var(--sc-4) 0 0; }

  @media (hover: hover) and (pointer: fine) {
    .mobile-only { display: none; }
  }
  @media (hover: none), (pointer: coarse) {
    .desktop-only { display: none; }
  }

  .support-thanks { margin: var(--sc-9) auto 0; color: var(--sc-ink-soft); }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    margin: 0;
    padding: 10px 18px;
    border-radius: var(--sc-r-pill);
    background: var(--night);
    color: #ecede7;
    font-size: var(--sc-t-sm);
    box-shadow: var(--sc-e3);
    opacity: 0;
    translate: -50% 12px;
    pointer-events: none;
    transition: opacity var(--sc-d-base) var(--sc-ease-out), translate var(--sc-d-base) var(--sc-ease-out);
  }
  .toast.is-shown { opacity: 1; translate: -50% 0; }

  @media (max-width: 760px) {
    .plates { grid-template-columns: 1fr; gap: var(--sc-8); }
    .plate-panel { grid-template-columns: minmax(0, 220px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate-panel.is-opening { animation: none; }
  }
</style>

<script>
  const toast = document.querySelector<HTMLElement>('.toast');
  let toastTimer: number | undefined;

  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('is-shown');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-shown'), 2000);
  }

  document.querySelectorAll<HTMLElement>('.plate').forEach((plate) => {
    const toggle = plate.querySelector<HTMLButtonElement>('.plate-toggle')!;
    const label = toggle.querySelector<HTMLElement>('.plate-toggle-label')!;
    const panel = plate.querySelector<HTMLElement>('.plate-panel')!;

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Hide QR code' : 'Show QR code';
      panel.hidden = !open;
      panel.classList.toggle('is-opening', open);
    });
    panel.addEventListener('animationend', () => panel.classList.remove('is-opening'));

    const copyBtn = plate.querySelector<HTMLButtonElement>('.copy-btn');
    copyBtn?.addEventListener('click', async () => {
      const value = copyBtn.dataset.copy ?? '';
      const copyLabel = copyBtn.querySelector<HTMLElement>('.copy-label')!;
      try {
        await navigator.clipboard.writeText(value);
        copyBtn.classList.add('is-copied');
        copyLabel.textContent = 'Copied';
        showToast(`Copied ${value}`);
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyLabel.textContent = 'Copy';
        }, 1800);
      } catch {
        showToast('Copy failed. Select the text and copy it instead.');
      }
    });
  });
</script>
