---
import { counts, awards, papers, certificates, education, links } from '../data/profile';

const elsewhere = [
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'LeetCode', href: links.leetcode },
  { label: 'HackerRank', href: links.hackerrank },
  { label: 'Medium', href: links.medium },
];
---

<section id="record" class="record g-paper" data-ground="paper">
  <div class="wrap record-grid">
    <header class="record-head" data-sc-in data-sc-stagger="70">
      <h2 class="display display--lg">On the record.</h2>
      <ul class="tally">
        {counts.map((c) => (
          <li>
            <span class="tally-n" data-sc-count={`0 ${c.value}`} data-sc-count-ms="1400">{c.value}</span>
            {c.href ? (
              <a class="text-link tally-label" href={c.href} target="_blank" rel="noopener noreferrer">{c.label}</a>
            ) : (
              <span class="tally-label">{c.label}</span>
            )}
          </li>
        ))}
      </ul>
    </header>

    <div class="record-body">
      <section class="entry-group" data-sc-in data-sc-stagger="50" aria-labelledby="rec-awards">
        <h3 id="rec-awards" class="mono">Recognition</h3>
        {awards.map((a) => (
          <div class="entry">
            <p class="entry-title">{a.title}</p>
            <p class="entry-meta">{a.org}, <span class="nw">{a.date}</span>. {a.note}</p>
          </div>
        ))}
      </section>

      <section class="entry-group" data-sc-in data-sc-stagger="50" aria-labelledby="rec-papers">
        <h3 id="rec-papers" class="mono">IEEE publications</h3>
        {papers.map((p) => (
          <div class="entry">
            <p class="entry-title">{p.title}</p>
            <p class="entry-meta">{p.venue}. {p.note}</p>
          </div>
        ))}
      </section>

      <div class="record-pair">
        <section class="entry-group" data-sc-in data-sc-stagger="50" aria-labelledby="rec-certs">
          <h3 id="rec-certs" class="mono">Certificates</h3>
          {certificates.map((c) => (
            <div class="entry">
              <p class="entry-title">{c.title}</p>
              <p class="entry-meta">{c.org}, <span class="nw">{c.date}</span></p>
            </div>
          ))}
        </section>

        <section class="entry-group" data-sc-in data-sc-stagger="50" aria-labelledby="rec-edu">
          <h3 id="rec-edu" class="mono">Education</h3>
          {education.map((e) => (
            <div class="entry">
              <p class="entry-title">{e.title}</p>
              <p class="entry-meta">{e.org}, <span class="nw">{e.date}</span></p>
            </div>
          ))}
        </section>
      </div>

      <p class="record-elsewhere" data-sc-in>
        <span class="mono">Elsewhere</span>
        {elsewhere.map((l) => (
          <a class="text-link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .record { padding-block: var(--sc-section); }
  .record-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--sc-8) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .record-head { position: sticky; top: var(--sc-7); }

  .tally { list-style: none; margin: var(--sc-7) 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--sc-6) var(--sc-5); }
  .tally li { display: flex; flex-direction: column; gap: 6px; }
  .tally-n {
    font-family: var(--sc-font-display);
    font-weight: 800;
    font-size: var(--sc-t-3xl);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .tally-label { font-size: var(--sc-t-sm); color: var(--sc-ink-soft); max-width: 22ch; }

  .record-body { display: flex; flex-direction: column; gap: var(--sc-8); padding-top: var(--sc-3); }
  .entry-group h3 { margin: 0 0 var(--sc-3); font-weight: 500; }
  .entry { padding-block: var(--sc-4); border-top: 1px solid var(--sc-hairline-strong); }
  .entry-title {
    margin: 0;
    font-family: var(--sc-font-display);
    font-weight: 700;
    font-size: var(--sc-t-lg);
    line-height: 1.2;
    letter-spacing: var(--sc-track-snug);
    text-wrap: balance;
  }
  .entry-meta { margin: 6px 0 0; font-size: var(--sc-t-sm); color: var(--sc-ink-soft); max-width: 62ch; text-wrap: pretty; }
  .record-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sc-6); }

  .record-elsewhere { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sc-3) var(--sc-5); margin: 0; font-weight: 500; }

  @media (max-width: 960px) {
    .record-grid { grid-template-columns: 1fr; }
    .record-head { position: static; }
    .record-pair { grid-template-columns: 1fr; gap: var(--sc-8); }
  }
</style>
