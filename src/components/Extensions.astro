---
import config from '../data/config.json';

const extensions = [
  {
    ...config.extensions.touchlock,
    color: "cyan",
  },
  {
    ...config.extensions.bingit,
    color: "violet",
  },
  {
    ...config.extensions.autoprompt,
    color: "cyan",
  },
];
---

<section class="section extensions-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Published on Chrome Web Store</span>
      <h2 class="section-title">Browser Extensions</h2>
      <p class="section-subtitle">
        Extensions I've built and published, used by real people daily
      </p>
    </div>

    <div class="extensions-grid">
      {extensions.map((ext, i) => (
        <a href={ext.siteUrl} target="_blank" rel="noopener noreferrer" class={`extension-card card reveal reveal-delay-${i + 1}`}>
          <div class="ext-icon-wrapper">
            <img src={ext.icon} alt={ext.name} class="ext-icon-img" width="48" height="48" loading="lazy" />
          </div>
          <div class="ext-content">
            <h3 class="ext-name">{ext.name}</h3>
            <p class="ext-tagline">{ext.tagline}</p>
            <div class="ext-meta">
              <span class="ext-users">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {ext.users}+ users
              </span>
              <span class="ext-rating">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {ext.rating}
              </span>
              <span class="ext-version">v{ext.version}</span>
            </div>
          </div>
          <div class="ext-links">
            <span class="ext-link-site" title="Visit site">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .extensions-section { padding-top: 0; }
  .extensions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .extension-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    position: relative;
  }
  .extension-card:hover { transform: translateY(-3px); }
  .ext-icon-wrapper {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .ext-icon-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
  .ext-content { flex: 1; min-width: 0; }
  .ext-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }
  .ext-tagline {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .ext-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ext-users, .ext-rating, .ext-version {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .ext-users { color: var(--text-secondary); }
  .ext-rating { color: #fbbf24; }
  .ext-version { color: var(--text-muted); }
  .ext-links {
    flex-shrink: 0;
  }
  .ext-link-site {
    color: var(--text-muted);
    transition: all var(--transition-fast);
    display: flex;
  }
  .extension-card:hover .ext-link-site {
    color: var(--accent-cyan);
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .extensions-grid { grid-template-columns: 1fr; }
  }
</style>
