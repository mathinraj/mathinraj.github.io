---
import { person, links } from '../data/profile';
const year = new Date().getFullYear();
---

<section id="contact" class="colophon g-night" data-sc-act="pin" data-sc-span="1.3" data-ground="night" aria-labelledby="contact-title">
  <div data-sc-stage class="colophon-stage">
    <svg class="head-graph" aria-hidden="true"><path class="head-path" pathLength="1"></path></svg>
    <div class="wrap colophon-inner">
      <div class="colophon-main">
        <h2 id="contact-title" class="display display--lg">The next commit is yours.</h2>
        <p class="colophon-text">
          Hiring, or have something worth building? Write to me at
          <a class="text-link" href={`mailto:${person.email}`}>{person.email}</a>,
          or take the <a class="text-link" href={person.resume} download>Resume (PDF)</a> with you.
          Using one of my extensions? Tell me what to fix next, and if it saved you time, you can
          <a class="text-link" href="/contribute">Support the work</a>.
        </p>
        <p class="colophon-elsewhere">
          <a class="text-link" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="text-link" href={links.medium} target="_blank" rel="noopener noreferrer">Medium</a>
          <a class="text-link" href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </p>
      </div>

      <footer class="colophon-foot">
        <p class="head-tag mono"><span class="head-dot" aria-hidden="true"></span>HEAD → you</p>
        <p class="mono">Set in Archivo and Geist. Built with Astro. © {year} {person.name}.</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .colophon-stage { display: flex; }
  .colophon-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(3rem, 14vh, 9rem) var(--sc-6);
  }
  @media (max-width: 1023px) {
    .colophon-inner { padding-top: calc(52px + var(--sc-8)); }
  }
  .colophon-main { max-width: 54rem; }
  .colophon-text {
    margin: var(--sc-6) 0 0;
    max-width: 52ch;
    font-size: var(--sc-t-lg);
    line-height: 1.55;
    color: var(--sc-ink-soft);
    text-wrap: pretty;
  }
  .colophon-text a { color: var(--sc-ink); }
  .colophon-elsewhere { display: flex; flex-wrap: wrap; gap: var(--sc-2) var(--sc-5); margin: var(--sc-6) 0 0; font-weight: 500; }

  .colophon-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sc-3) var(--sc-6);
  }
  .colophon-foot p { margin: 0; }
  .head-tag { display: inline-flex; align-items: center; gap: 12px; color: var(--sc-accent); font-size: var(--sc-t-sm); }
  .head-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--sc-accent);
    outline: 1px solid var(--sc-accent);
    outline-offset: 3px;
  }

  .head-graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .head-path {
    fill: none;
    stroke: var(--sc-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, var(--sc-p, 1) * 1.6, 1));
  }
  @media (prefers-reduced-motion: reduce) {
    .head-path { stroke-dashoffset: 0; }
  }
  @media (max-width: 700px) {
    .colophon-inner { padding-top: calc(52px + var(--sc-6)); gap: var(--sc-5); }
    .colophon-main h2 { font-size: clamp(2.2rem, 11vw, 3rem); }
    .colophon-text { margin-top: var(--sc-5); font-size: var(--sc-t-base); }
    .colophon-elsewhere { margin-top: var(--sc-5); }
  }
  @media (max-width: 700px) and (max-height: 700px) {
    .colophon-inner { padding-top: calc(52px + var(--sc-4)); }
    .colophon-text { line-height: 1.5; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.colophon-stage');
  const svg = stage?.querySelector<SVGSVGElement>('.head-graph');
  const path = stage?.querySelector<SVGPathElement>('.head-path');
  const dot = stage?.querySelector<HTMLElement>('.head-dot');
  const nodes = document.querySelectorAll<HTMLElement>('.folio-node');
  const headNode = nodes[nodes.length - 1];

  function place() {
    if (!stage || !svg || !path || !dot) return;
    const box = stage.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    const d = dot.getBoundingClientRect();
    const tx = d.left - box.left - 7;
    const ty = d.top + d.height / 2 - box.top;
    const rail = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rail')) || 0;

    if (rail > 0 && headNode) {
      const n = headNode.getBoundingClientRect();
      const nx = n.left + n.width / 2;
      const ny = n.top + n.height / 2 - box.top;
      const r = Math.min(28, Math.max(0, ty - ny));
      path.setAttribute('d', `M ${nx} ${ny + 6} L ${nx} ${ty - r} Q ${nx} ${ty} ${nx + r} ${ty} L ${tx} ${ty}`);
    } else {
      path.setAttribute('d', `M 0 ${ty} L ${tx} ${ty}`);
    }
  }
  place();
  addEventListener('resize', place);
  addEventListener('load', place);
  addEventListener('scroll', () => requestAnimationFrame(place), { passive: true });
  document.fonts?.ready.then(place);
</script>
