---
import { extensions, totalUsers } from '../data/profile';

const START = 0.06;
const STEP = 0.19;
const DRAW = 0.12;
const branches = extensions.map((e, i) => {
  const s = START + i * STEP;
  const a = s + DRAW - 0.02;
  return { ...e, s, a };
});
const last = branches[branches.length - 1].a + 0.06;
---

<section
  class="branches g-brand"
  data-sc-act="pin"
  data-sc-span="4"
  data-span-reduced="1.3"
  data-ground="brand"
  aria-labelledby="branches-title"
>
  <div data-sc-stage class="branches-stage">
    <svg class="branches-graph" aria-hidden="true">
      <line class="branches-main" x1="0" y1="0" x2="0" y2="0"></line>
      {branches.map((b) => (
        <path class="branches-path" pathLength="1" style={`--s:${b.s.toFixed(3)};--l:${DRAW}`}></path>
      ))}
    </svg>

    <div class="wrap branches-inner">
      <header class="branches-head">
        <h2 id="branches-title" class="display display--md">Four branches off main.</h2>
        <p class="branches-total">
          <span class="branches-total-n" data-sc-count={`0 ${totalUsers}`} data-sc-count-at={`${START} ${last.toFixed(2)}`}>{totalUsers}</span>
          people use them.
        </p>
      </header>

      <ol class="branch-list">
        {branches.map((b) => (
          <li class="branch" style={`--a:${b.a.toFixed(3)}`} id={`ext-${b.key}`}>
            <span class="branch-dot" aria-hidden="true"></span>
            <img class="branch-icon" src={b.icon} alt="" width="56" height="56" loading="lazy" />
            <div class="branch-name">
              <h3>{b.name}</h3>
              <p>{b.tagline}</p>
            </div>
            <p class="branch-about">{b.about}</p>
            <p class="branch-facts">
              {b.users != null ? (
                <span><b data-sc-count={`0 ${b.users}`} data-sc-count-at={`${b.a.toFixed(3)} ${(b.a + 0.07).toFixed(3)}`}>{b.users}</b> users</span>
              ) : (
                <span><b>New</b></span>
              )}
              {b.rating != null && <span>{b.rating.toFixed(1)} rating</span>}
              <span>v{b.version}</span>
            </p>
            <p class="branch-links">
              {b.store && <a class="text-link" href={b.store} target="_blank" rel="noopener noreferrer">Install</a>}
              {b.site && <a class="text-link" href={b.site} target="_blank" rel="noopener noreferrer">Website</a>}
              {!b.store && <a class="text-link" href={b.code} target="_blank" rel="noopener noreferrer">Code</a>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .branches-stage { display: flex; align-items: stretch; }

  .branches-graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .branches-path, .branches-main {
    fill: none;
    stroke: var(--sc-ink);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .branches-main { display: none; stroke-opacity: 0.5; }
  .branches-path {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, (var(--sc-p, 1) - var(--s)) / var(--l), 1));
  }

  .branches-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-block: clamp(1.5rem, 6vh, 3.5rem) clamp(1rem, 4vh, 2.5rem);
  }
  @media (max-width: 1023px) {
    .branches-inner { padding-top: calc(52px + var(--sc-4)); }
    .branches-main { display: block; }
  }

  .branches-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sc-2) var(--sc-6);
    padding-bottom: var(--sc-5);
  }
  .branches-total { margin: 0; font-size: var(--sc-t-lg); color: var(--sc-ink-soft); }
  .branches-total-n {
    font-family: var(--sc-font-display);
    font-weight: 800;
    font-size: var(--sc-t-2xl);
    letter-spacing: -0.03em;
    color: var(--sc-ink);
    margin-right: 0.2em;
  }

  .branch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
  }
  .branch {
    --t: clamp(0, (var(--sc-p, 1) - var(--a)) / 0.05, 1);
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 15rem) minmax(0, 1fr) minmax(0, 13rem) 9rem;
    gap: var(--sc-5);
    align-items: center;
    border-top: 1px solid var(--sc-hairline-strong);
    opacity: calc(0.12 + 0.88 * var(--t));
  }
  .branch-dot {
    position: absolute;
    left: -22px;
    top: 50%;
    width: 11px;
    height: 11px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--sc-ink);
    scale: var(--t);
  }
  .branch-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: #f4f5f0;
    box-shadow: var(--sc-e2);
  }
  .branch-name h3 {
    margin: 0;
    font-family: var(--sc-font-display);
    font-weight: 760;
    font-size: var(--sc-t-xl);
    line-height: 1.05;
    letter-spacing: var(--sc-track-snug);
  }
  .branch-name p { margin: 4px 0 0; font-size: var(--sc-t-sm); color: var(--sc-ink-soft); }
  .branch-about { margin: 0; max-width: 46ch; font-size: var(--sc-t-sm); color: var(--sc-ink-soft); text-wrap: pretty; }
  .branch-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 0;
    font-family: var(--sc-font-mono);
    font-size: var(--sc-t-xs);
    color: var(--sc-ink-soft);
  }
  .branch-facts b {
    font-family: var(--sc-font-display);
    font-weight: 800;
    font-size: var(--sc-t-lg);
    color: var(--sc-ink);
    letter-spacing: -0.02em;
    margin-right: 3px;
  }
  .branch-facts span:first-child { flex-basis: 100%; }
  .branch-links { display: flex; gap: var(--sc-4); margin: 0; justify-content: flex-end; font-weight: 500; font-size: var(--sc-t-sm); }

  @media (max-width: 1180px) {
    .branch { grid-template-columns: 56px minmax(0, 13rem) minmax(0, 1fr) 8rem; }
    .branch-facts { display: none; }
  }
  @media (max-width: 860px) {
    .branch-list { padding-left: 22px; }
    .branch {
      grid-template-columns: 44px minmax(0, 1fr) auto;
      grid-template-areas: 'icon name facts' 'icon links facts';
      gap: 4px var(--sc-4);
      align-content: center;
    }
    .branch-dot { left: -14px; }
    .branch-icon { grid-area: icon; width: 44px; height: 44px; border-radius: 11px; align-self: center; }
    .branch-name { grid-area: name; }
    .branch-name h3 { font-size: var(--sc-t-lg); }
    .branch-about { display: none; }
    .branch-facts { display: block; grid-area: facts; text-align: right; align-self: center; }
    .branch-facts span:not(:first-child) { display: none; }
    .branch-facts b { display: block; margin: 0; }
    .branch-links { grid-area: links; justify-content: flex-start; }
  }
  @media (max-width: 860px) and (max-height: 700px) {
    .branch-name p { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .branch { opacity: 1; }
    .branch-dot { scale: 1; }
    .branches-path { stroke-dashoffset: 0; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.branches-stage');
  const svg = stage?.querySelector<SVGSVGElement>('.branches-graph');
  const paths = Array.from(stage?.querySelectorAll<SVGPathElement>('.branches-path') ?? []);
  const main = stage?.querySelector<SVGLineElement>('.branches-main');
  const dots = Array.from(stage?.querySelectorAll<HTMLElement>('.branch-dot') ?? []);

  function draw() {
    if (!stage || !svg) return;
    const box = stage.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    const rail = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rail')) || 0;
    const gutter = parseFloat(getComputedStyle(stage.querySelector('.wrap')!).paddingRight) || 20;
    const x0 = rail > 0 ? rail / 2 : Math.round(gutter * 0.45);

    dots.forEach((dot, i) => {
      const r = dot.getBoundingClientRect();
      const x = r.left + r.width / 2 - box.left;
      const y = r.top + r.height / 2 - box.top;
      const rise = Math.min(110, y * 0.4);
      const bend = Math.min(48, (x - x0) * 0.5);
      paths[i]?.setAttribute(
        'd',
        `M ${x0} ${y - rise} C ${x0} ${y - rise * 0.25}, ${x0 + bend * 0.2} ${y}, ${x0 + bend} ${y} L ${x - 6} ${y}`,
      );
    });
    if (main) {
      main.setAttribute('x1', String(x0));
      main.setAttribute('x2', String(x0));
      main.setAttribute('y1', '0');
      main.setAttribute('y2', String(box.height));
    }
  }

  draw();
  addEventListener('resize', draw);
  addEventListener('load', draw);
  document.fonts?.ready.then(draw);
</script>
