---

<section id="profiles" class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Find me online</span>
      <h2 class="section-title">Profiles & Publications</h2>
    </div>

    <div class="profiles-grid">
      {profiles.map((profile, i) => (
        <a href={profile.url} target="_blank" rel="noopener noreferrer" class={`profile-card card reveal reveal-delay-${Math.min(i + 1, 3)}`}>
          <div class="profile-icon">
            <Fragment set:html={profile.icon} />
          </div>
          <div class="profile-info">
            <h3 class="profile-name">{profile.name}</h3>
            <span class="profile-stat">{profile.stat}</span>
          </div>
          <div class="profile-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </div>
        </a>
      ))}
    </div>

    <div class="publications-section">
      <h3 class="pub-heading reveal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        IEEE Publications
      </h3>
      <div class="pub-list">
        {publications.map((pub, i) => (
          <div class={`pub-card card reveal reveal-delay-${i + 1}`}>
            <h4 class="pub-title">{pub.title}</h4>
            <span class="pub-venue">{pub.venue}</span>
            <p class="pub-desc">{pub.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }
  .profile-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px;
    cursor: pointer;
  }
  .profile-card:hover { transform: translateY(-3px); }
  .profile-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(6, 182, 212, 0.06);
    color: var(--accent-cyan);
    flex-shrink: 0;
    transition: all var(--transition-base);
  }
  .profile-card:hover .profile-icon {
    background: var(--accent-gradient);
    color: #fff;
  }
  .profile-info { flex: 1; min-width: 0; }
  .profile-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .profile-stat {
    font-size: 0.78rem;
    color: var(--text-muted);
    display: block;
    margin-top: 1px;
  }
  .profile-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }
  .profile-card:hover .profile-arrow {
    color: var(--accent-cyan);
    transform: translate(2px, -2px);
  }

  .publications-section { max-width: 800px; margin: 0 auto; }
  .pub-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .pub-heading svg { color: var(--accent-cyan); }
  .pub-list { display: flex; flex-direction: column; gap: 16px; }
  .pub-card { padding: 24px; }
  .pub-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .pub-venue {
    font-size: 0.78rem;
    color: var(--accent-cyan);
    font-weight: 500;
    display: block;
    margin-bottom: 10px;
  }
  .pub-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 480px) {
    .profiles-grid { grid-template-columns: 1fr; }
  }
</style>
