---
function calcDuration(startStr: string): string {
  const now = new Date();
  const parts = startStr.split(' ');
  const monthMap: Record<string, number> = {
    Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
    Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
  };
  const month = monthMap[parts[0]] ?? 0;
  const year = parseInt(parts[1]);
  const start = new Date(year, month, 1);
  let months = (now.getFullYear() - start.getFullYear()) * 12 + (now.getMonth() - start.getMonth());
  if (months < 1) months = 1;
  const yrs = Math.floor(months / 12);
  const mos = months % 12;
  if (yrs === 0) return `${mos} mo${mos !== 1 ? 's' : ''}`;
  if (mos === 0) return `${yrs} yr${yrs !== 1 ? 's' : ''}`;
  return `${yrs} yr${yrs !== 1 ? 's' : ''} ${mos} mo${mos !== 1 ? 's' : ''}`;
}

function calcCompanyDuration(startStr: string, endStr: string | null): string {
  const now = new Date();
  const monthMap: Record<string, number> = {
    Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
    Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
  };
  const sp = startStr.split(' ');
  const start = new Date(parseInt(sp[1]), monthMap[sp[0]] ?? 0, 1);
  let end = now;
  if (endStr) {
    const ep = endStr.split(' ');
    end = new Date(parseInt(ep[1]), monthMap[ep[0]] ?? 0, 1);
  }
  let months = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth());
  if (months < 1) months = 1;
  const yrs = Math.floor(months / 12);
  const mos = months % 12;
  if (yrs === 0) return `${mos} mo${mos !== 1 ? 's' : ''}`;
  if (mos === 0) return `${yrs} yr${yrs !== 1 ? 's' : ''}`;
  return `${yrs} yr${yrs !== 1 ? 's' : ''} ${mos} mo${mos !== 1 ? 's' : ''}`;
}

const cognizantDuration = calcCompanyDuration("Oct 2024", null);
const deltaDuration = calcCompanyDuration("Jan 2024", "Oct 2024");

const experiences = [
  {
    role: "Junior Software Engineer",
    company: "Cognizant",
    companyDuration: cognizantDuration,
    location: "Coimbatore, Tamil Nadu",
    period: "Oct 2025 — Present",
    duration: calcDuration("Oct 2025"),
    type: "Full-time",
    description: "Building and maintaining enterprise fintech applications for a Fortune 500 client, working across the full stack with microservices architecture.",
    highlights: [
      "Developed an AI-powered campaign management tool that automates the entire workflow for marketing teams — from PPT upload to landing page generation via Figma designs, reducing campaign launch time from days to minutes",
      "Built an automated security compliance remediation tool (Antidote) that fetches Jira tickets, identifies compliance issues, applies fixes, and updates Jira — streamlining repetitive monthly security tasks across the team",
      "Work daily with Spring Boot microservices, React UIs, Kubernetes clusters, Jenkins CI/CD pipelines, and AWS services (EC2, RDS, IAM, DynamoDB)",
    ],
    skills: ["Spring Boot", "React", "Kubernetes", "AWS", "Jenkins", "Microservices", "AI Tools"],
    showCompanyDuration: true,
  },
  {
    role: "Software Engineer Trainee",
    company: "Cognizant",
    companyDuration: null,
    location: "Coimbatore, Tamil Nadu",
    period: "Oct 2024 — Oct 2025",
    duration: "1 yr",
    type: "Full-time",
    description: "Completed intensive Full Stack Developer program at Cognizant Academy, building real-world applications from day one.",
    highlights: [
      "Built SmartSpend — a full-stack expense tracker with Spring Boot backend and React UI, later evolved into SpendTrak (a PWA with 100% offline-first architecture)",
      "Trained in Spring Boot, Spring Security, React, SQL, and modern development workflows",
    ],
    skills: ["Spring Boot", "React", "SQL", "Full-Stack Development"],
    showCompanyDuration: false,
  },
  {
    role: "Assistant Engineer / Trainee",
    company: "Delta Electronics",
    companyDuration: deltaDuration,
    location: "Krishnagiri, Tamil Nadu",
    period: "Jan 2024 — Oct 2024",
    duration: deltaDuration,
    type: "Full-time",
    description: "Contributed to engineering operations in an industrial manufacturing environment. Developed internal automation tools to streamline recurring manual processes.",
    highlights: [],
    skills: ["Automation", "Problem Solving"],
    showCompanyDuration: true,
  },
];
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Where I've worked</span>
      <h2 class="section-title">Experience</h2>
    </div>

    <div class="timeline">
      {experiences.map((exp, i) => (
        <div class={`timeline-item reveal reveal-delay-${Math.min(i + 1, 3)}`}>
          <div class="timeline-marker">
            <div class="marker-dot"></div>
            {i < experiences.length - 1 && <div class="marker-line"></div>}
          </div>
          <div class="timeline-card card">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{exp.role}</h3>
                <div class="timeline-company">
                  <span class="company-name">{exp.company}</span>
                  {exp.showCompanyDuration && exp.companyDuration && (
                    <>
                      <span class="company-sep">·</span>
                      <span class="company-duration">{exp.companyDuration}</span>
                    </>
                  )}
                  <span class="company-sep">·</span>
                  <span class="company-type">{exp.type}</span>
                </div>
              </div>
              <div class="timeline-meta">
                <span class="timeline-period">{exp.period}</span>
                <span class="timeline-duration">{exp.duration}</span>
              </div>
            </div>
            <p class="timeline-desc">{exp.description}</p>
            {exp.highlights.length > 0 && (
              <ul class="timeline-highlights">
                {exp.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            <div class="timeline-skills">
              {exp.skills.map((s) => (
                <span class="tech-badge">{s}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  .timeline-item {
    display: flex;
    gap: 24px;
  }
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-gradient);
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.3);
    flex-shrink: 0;
    margin-top: 24px;
  }
  .marker-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.05));
    min-height: 20px;
  }
  .timeline-card {
    padding: 28px;
    margin-bottom: 20px;
    flex: 1;
  }
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 12px;
  }
  .timeline-role {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .timeline-company {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .company-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }
  .company-sep { color: var(--text-muted); font-size: 0.8rem; }
  .company-type { font-size: 0.8rem; color: var(--text-muted); }
  .company-duration { font-size: 0.8rem; color: var(--text-secondary); font-weight: 500; }
  .timeline-meta { text-align: right; flex-shrink: 0; }
  .timeline-period {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .timeline-duration {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .timeline-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .timeline-highlights {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .timeline-highlights li {
    position: relative;
    padding-left: 20px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .timeline-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
    opacity: 0.6;
  }
  .timeline-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .timeline-header { flex-direction: column; gap: 4px; }
    .timeline-meta { text-align: left; }
    .timeline-card { padding: 20px; }
  }
  @media (max-width: 480px) {
    .timeline-marker { display: none; }
    .timeline-item { gap: 0; }
    .timeline-card {
      border-left: 3px solid transparent;
      border-image: var(--accent-gradient) 1;
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    }
  }
</style>
