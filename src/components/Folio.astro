---
import { chapters, person } from '../data/profile';
---

<nav class="folio" aria-label="Chapters" data-ground="paper">
  <a class="folio-mark" href="#top" aria-label="Back to the title page">MR</a>
  <div class="folio-track">
    <span class="folio-line" aria-hidden="true"></span>
    {chapters.map((c, i) => (
      <a class="folio-node" href={`#${c.id}`} style={`--f:${i / (chapters.length - 1)}`} data-numeral={c.numeral} data-title={c.title}>
        <span class="folio-tip">{c.numeral && <b>{c.numeral}</b>} {c.title}</span>
      </a>
    ))}
    <p class="folio-label" aria-hidden="true"></p>
  </div>
  <a class="folio-cv" href={person.resume} download>Resume<br />PDF</a>
</nav>

<div class="folio-bar" data-ground="paper">
  <a class="folio-bar-label" href="#top"><span class="folio-bar-num"></span><span class="folio-bar-title">{person.name}</span></a>
  <button class="folio-bar-btn" type="button" aria-expanded="false" aria-controls="folio-index">Index</button>
  <span class="folio-bar-line" aria-hidden="true"></span>
</div>

<div class="folio-index g-night" id="folio-index" hidden>
  <ol>
    {chapters.map((c) => (
      <li><a href={`#${c.id}`}><span class="mono">{c.numeral || '·'}</span>{c.title}</a></li>
    ))}
  </ol>
  <p class="folio-index-extra">
    <a class="text-link" href={person.resume} download>Resume (PDF)</a>
    <a class="text-link" href="/contribute">Support the work</a>
  </p>
</div>

<style>
  .folio {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--rail);
    z-index: var(--sc-z-chrome);
    display: none;
    flex-direction: column;
    align-items: center;
    padding-block: 26px 24px;
    --f-ink: #15171d;
    --f-soft: #4c5260;
    --f-line: var(--brand);
    --f-track: rgba(21, 23, 29, 0.16);
    --f-bg: var(--paper);
    color: var(--f-ink);
    transition: color var(--sc-d-base) var(--sc-ease-out);
  }
  .folio[data-ground='paper-2'] { --f-bg: var(--paper-2); }
  .folio[data-ground^='night'] {
    --f-ink: #ecede7; --f-soft: #a0a6b5; --f-line: var(--brand-light); --f-track: rgba(236, 237, 231, 0.16); --f-bg: var(--night);
  }
  .folio[data-ground='night-2'] { --f-bg: var(--night-2); }
  .folio[data-ground='brand'] {
    --f-ink: #f4f5f0; --f-soft: #b8cdbf; --f-line: #f4f5f0; --f-track: rgba(244, 245, 240, 0.28); --f-bg: var(--brand);
  }
  @media (min-width: 1024px) {
    .folio { display: flex; }
  }

  .folio-mark {
    font-family: var(--sc-font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: inherit;
  }

  .folio-track {
    position: relative;
    flex: 1;
    width: 100%;
    margin-block: 28px 24px;
  }
  .folio-track::before, .folio-line {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    translate: -0.5px 0;
    background: var(--f-track);
  }
  .folio-line {
    width: 2px;
    translate: -1px 0;
    background: var(--f-line);
    transform-origin: 50% 0;
    transform: scaleY(var(--prog, 0));
  }

  .folio-node {
    position: absolute;
    left: 50%;
    top: calc(var(--f) * 100%);
    width: 28px;
    height: 28px;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .folio-node::before {
    content: '';
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--f-line);
    background: var(--f-bg);
    transition: background-color var(--sc-d-fast) var(--sc-ease-out), scale var(--sc-d-fast) var(--sc-ease-out);
  }
  .folio-node.is-passed::before { background: var(--f-line); }
  .folio-node.is-active::before { scale: 1.35; }
  .folio-node:focus-visible { outline-offset: 0; border-radius: 50%; }

  .folio-tip {
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    translate: -4px -50%;
    white-space: nowrap;
    padding: 6px 10px;
    border-radius: var(--sc-r-sm);
    background: var(--night);
    color: #ecede7;
    font-size: 0.8rem;
    box-shadow: var(--sc-e2);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--sc-d-fast) var(--sc-ease-out), translate var(--sc-d-fast) var(--sc-ease-out);
  }
  .folio-tip b { font-family: var(--sc-font-mono); font-weight: 500; margin-right: 4px; color: var(--brand-light); }
  .folio-node:hover .folio-tip, .folio-node:focus-visible .folio-tip { opacity: 1; translate: 0 -50%; }

  .folio-label {
    position: absolute;
    left: 50%;
    top: 0;
    margin: 0;
    margin-left: -26px;
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--sc-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--f-soft);
    white-space: nowrap;
    translate: 0 var(--label-y, 0px);
    transition: translate var(--sc-d-base) var(--sc-ease-out), opacity var(--sc-d-fast) var(--sc-ease-out);
  }
  .folio-label :global(b) { color: var(--f-ink); font-weight: 500; }

  .folio-cv {
    font-family: var(--sc-font-mono);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-align: center;
    color: var(--f-soft);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  .folio-cv:hover { color: var(--f-ink); }
  .folio-cv { transition: opacity var(--sc-d-fast) var(--sc-ease-out); }
  .folio.is-at-head .folio-cv { opacity: 0; visibility: hidden; }

  /* ---- phones and tablets: the folio moves to a slim top bar ---- */
  .folio-bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 52px;
    z-index: var(--sc-z-chrome);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: var(--sc-gutter);
    padding-top: env(safe-area-inset-top);
    background: color-mix(in oklab, var(--bar-bg, var(--paper)) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--bar-ink, #15171d);
    --bar-line: var(--brand);
    transition: background-color var(--sc-d-base) var(--sc-ease-out), color var(--sc-d-base) var(--sc-ease-out);
  }
  .folio-bar[data-ground='paper-2'] { --bar-bg: var(--paper-2); }
  .folio-bar[data-ground^='night'] { --bar-bg: var(--night); --bar-ink: #ecede7; --bar-line: var(--brand-light); }
  .folio-bar[data-ground='night-2'] { --bar-bg: var(--night-2); }
  .folio-bar[data-ground='brand'] { --bar-bg: var(--brand); --bar-ink: #eef0e6; --bar-line: #eef0e6; }
  @media (min-width: 1024px) {
    .folio-bar, .folio-index { display: none !important; }
  }
  .folio-bar-label {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
  }
  .folio-bar-num { font-family: var(--sc-font-mono); font-size: 0.74rem; opacity: 0.75; }
  .folio-bar-num:empty { display: none; }
  .folio-bar-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .folio-bar-btn {
    flex: none;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: var(--sc-r-pill);
    background: none;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 120ms var(--sc-ease-out);
  }
  .folio-bar-btn:active { transform: scale(0.97); }
  .folio-bar-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--bar-line);
    transform-origin: 0 50%;
    transform: scaleX(var(--prog, 0));
  }

  .folio-index {
    position: fixed;
    inset: 52px 0 auto 0;
    z-index: var(--sc-z-chrome);
    padding: var(--sc-5) var(--sc-gutter) var(--sc-6);
    box-shadow: var(--sc-e3);
  }
  .folio-index ol { list-style: none; margin: 0; padding: 0; }
  .folio-index li a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    font-family: var(--sc-font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid var(--sc-hairline);
  }
  .folio-index li a .mono { width: 3.2rem; flex: none; }
  .folio-index-extra { display: flex; gap: 20px; margin: var(--sc-5) 0 0; font-size: 0.95rem; }
</style>

<script>
  const root = document.documentElement;
  const folio = document.querySelector<HTMLElement>('.folio');
  const bar = document.querySelector<HTMLElement>('.folio-bar');
  const nodes = Array.from(document.querySelectorAll<HTMLAnchorElement>('.folio-node'));
  const label = document.querySelector<HTMLElement>('.folio-label');
  const track = document.querySelector<HTMLElement>('.folio-track');
  const barNum = document.querySelector<HTMLElement>('.folio-bar-num');
  const barTitle = document.querySelector<HTMLElement>('.folio-bar-title');
  const btn = document.querySelector<HTMLButtonElement>('.folio-bar-btn');
  const sheet = document.getElementById('folio-index');
  const chapters = nodes.map((n) => document.getElementById(n.hash.slice(1)));
  const grounds = Array.from(document.querySelectorAll<HTMLElement>('[data-ground]')).filter(
    (el) => !el.classList.contains('folio') && !el.classList.contains('folio-bar'),
  );

  let fractions: number[] = [];
  let active = -1;

  function layout() {
    const max = Math.max(1, root.scrollHeight - innerHeight);
    fractions = chapters.map((c) => {
      if (!c) return 1;
      const top = c.getBoundingClientRect().top + scrollY;
      return Math.min(1, Math.max(0, top / max));
    });
    nodes.forEach((n, i) => n.style.setProperty('--f', fractions[i].toFixed(4)));
    active = -1;
    update();
  }

  function update() {
    const max = Math.max(1, root.scrollHeight - innerHeight);
    const prog = Math.min(1, Math.max(0, scrollY / max));
    folio?.style.setProperty('--prog', prog.toFixed(4));
    bar?.style.setProperty('--prog', prog.toFixed(4));

    let next = 0;
    fractions.forEach((f, i) => { if (f <= prog + 0.002) next = i; });
    nodes.forEach((n, i) => n.classList.toggle('is-passed', fractions[i] <= prog + 0.002));
    if (next !== active) {
      active = next;
      nodes.forEach((n, i) => {
        n.classList.toggle('is-active', i === active);
        if (i === active) n.setAttribute('aria-current', 'true');
        else n.removeAttribute('aria-current');
      });
      const n = nodes[active];
      const num = n.dataset.numeral ?? '';
      const title = n.dataset.title ?? '';
      if (label && track) {
        label.innerHTML = num ? `<b>${num}</b>&nbsp;&nbsp;${title}` : title;
        const y = fractions[active] * track.clientHeight;
        const above = fractions[active] > 0.5;
        label.style.setProperty('--label-y', `${above ? y - label.offsetHeight - 18 : y + 18}px`);
      }
      folio?.classList.toggle('is-at-head', active === nodes.length - 1);
      if (barNum) barNum.textContent = num;
      if (barTitle) barTitle.textContent = title;
    }

    const probe = innerHeight * 0.5;
    const under = grounds.find((g) => {
      const r = g.getBoundingClientRect();
      return r.top <= probe && r.bottom > probe;
    });
    const barUnder = grounds.find((g) => {
      const r = g.getBoundingClientRect();
      return r.top <= 26 && r.bottom > 26;
    });
    if (under && folio) folio.dataset.ground = under.dataset.ground;
    if (barUnder && bar) bar.dataset.ground = barUnder.dataset.ground;
  }

  let queued = false;
  addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; update(); });
  }, { passive: true });
  addEventListener('resize', layout);
  addEventListener('load', layout);
  document.fonts?.ready.then(layout);
  new ResizeObserver(() => layout()).observe(document.body);
  layout();

  function setSheet(open: boolean) {
    if (!sheet || !btn) return;
    sheet.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Index';
  }
  btn?.addEventListener('click', () => setSheet(sheet?.hidden ?? false));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setSheet(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet && !sheet.hidden) { setSheet(false); btn?.focus(); }
  });
</script>
