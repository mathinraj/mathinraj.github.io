  .hush-inner { padding-block: var(--sc-9); }
  .hush-wipe { padding-block: 0.12em; }
  .hush h2 { font-size: clamp(3.2rem, 11vw, 11rem); letter-spacing: -0.05em; }
  .hush-note { margin: var(--sc-6) 0 0; font-size: var(--sc-t-sm); }
</style>
