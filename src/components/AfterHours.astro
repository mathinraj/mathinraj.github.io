<section id="after-hours" class="hush g-night" data-sc-act="flow" data-ground="night">
  <div class="wrap hush-inner">
    <div class="hush-wipe" data-sc-reveal="left" data-sc-reveal-at="0.22 0.5">
      <h2 class="display display--xl">After hours.</h2>
    </div>
    <p class="hush-note mono" data-sc-in>The day job is main. Everything below branched off it.</p>
  </div>
