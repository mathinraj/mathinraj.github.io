---
const skillCategories = [
  {
    title: "Languages",
    skills: ["Java", "Python", "JavaScript", "C", "HTML5", "SQL"]
  },
  {
    title: "Frameworks",
    skills: ["React", "Spring Boot", "Spring Security", "Tailwind CSS", "Bootstrap", "CSS3"]
  },
  {
    title: "Tools & Platforms",
    skills: ["Git / GitHub", "Docker", "Kubernetes", "Jenkins", "Maven", "ArgoCD", "Postman", "Vercel", "Jira", "Figma"]
  },
  {
    title: "Cloud & Databases",
    skills: ["AWS (EC2, RDS, IAM, DynamoDB)", "SQL", "DynamoDB", "REST APIs", "Microservices"]
  },
  {
    title: "AI & Other",
    skills: ["Claude AI", "Cursor IDE", "Chrome Extensions", "Manifest V3"]
  }
];

const techGrid = [
  { name: "Java", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" },
  { name: "Python", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" },
  { name: "JavaScript", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" },
  { name: "React", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" },
  { name: "Spring", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg" },
  { name: "Docker", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" },
  { name: "Kubernetes", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-original.svg" },
  { name: "AWS", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg" },
  { name: "Git", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" },
  { name: "PostgreSQL", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" },
  { name: "HTML5", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" },
  { name: "CSS3", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg" },
  { name: "Tailwind", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg" },
  { name: "Jenkins", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jenkins/jenkins-original.svg" },
  { name: "ArgoCD", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/argocd/argocd-original.svg" },
  { name: "C", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/c/c-original.svg" },
];

const education = [
  { period: "Oct 2024 — Jan 2025", title: "Full Stack Developer Program", org: "Cognizant Academy — Spring Boot, React, SQL" },
  { period: "2020 — 2024", title: "B.E. Electrical & Electronics Engineering", org: "Kongu Engineering College" },
  { period: "2018 — 2020", title: "Higher Secondary", org: "Malar Matriculation Hr Sec School" },
];

const certifications = [
  { name: "Claude Certified Architect — Professional", org: "Anthropic", year: "2026" },
  { name: "Claude Certified Architect — Foundations", org: "Anthropic", year: "2026" },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Get to know me</span>
      <h2 class="section-title">About Me</h2>
    </div>

    <div class="about-grid">
      <div class="about-image reveal">
        <div class="image-wrapper">
          <img src="/images/Mathinraj.jpg" alt="Mathinraj Ramasamy" loading="lazy" />
        </div>
      </div>

      <div class="about-content">
        <p class="about-text reveal">
          Full Stack Developer at <strong>Cognizant</strong> with 2+ years of experience
          building enterprise-grade fintech applications. I specialize in Java, Spring Boot, React,
          and cloud infrastructure — delivering production systems that serve real users at scale.
        </p>
        <p class="about-text reveal reveal-delay-1">
          Outside work, I build and ship products people actually use — from browser extensions with
          <strong>950+ active users</strong> on the Chrome Web Store to open-source tools and PWAs.
          I'm a relentless learner who thrives on exploring new tools, frameworks, and AI-powered
          development workflows.
        </p>
      </div>
    </div>

    <div class="about-tabs reveal reveal-delay-2">
      <div class="tab-buttons">
        <button class="tab-btn active" data-tab="skills">Skills</button>
        <button class="tab-btn" data-tab="tech">Tech Stack</button>
        <button class="tab-btn" data-tab="certs">Certifications</button>
        <button class="tab-btn" data-tab="education">Education</button>
      </div>

      <div class="tab-panel active" id="tab-skills">
        <div class="skills-categories">
          {skillCategories.map((cat) => (
            <div class="skill-category">
              <h4 class="category-title">{cat.title}</h4>
              <div class="skill-chips">
                {cat.skills.map((skill) => (
                  <span class="skill-chip">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="tab-tech">
        <div class="tech-icon-grid">
          {techGrid.map((tech) => (
            <div class="tech-icon-item">
              <img src={tech.icon} alt={tech.name} width="36" height="36" loading="lazy" />
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="tab-certs">
        <div class="cert-list">
          {certifications.map((cert) => (
            <div class="cert-item">
              <div class="cert-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div>
                <h4>{cert.name}</h4>
                <span class="cert-meta">{cert.org} · {cert.year}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="tab-education">
        <div class="edu-list">
          {education.map((edu) => (
            <div class="edu-item">
              <span class="edu-year">{edu.period}</span>
              <h4>{edu.title}</h4>
              <p>{edu.org}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 48px;
  }
  .image-wrapper {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 2px solid var(--border-color);
    transition: border-color var(--transition-base);
  }
  .image-wrapper:hover { border-color: var(--border-hover); }
  .image-wrapper img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .about-text {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 16px;
    line-height: 1.8;
  }
  .about-text strong { color: var(--text-primary); font-weight: 600; }

  .about-tabs { margin-top: 16px; }
  .tab-buttons {
    display: flex;
    gap: 4px;
    background: rgba(15, 23, 42, 0.5);
    padding: 4px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    margin-bottom: 28px;
    overflow-x: auto;
  }
  .tab-btn {
    padding: 10px 24px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    flex: 1;
    text-align: center;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--text-secondary); }
  .tab-btn.active {
    background: var(--accent-gradient);
    color: #fff;
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; animation: fade-in-up 0.3s ease; }

  .skills-categories { display: flex; flex-direction: column; gap: 24px; }
  .category-title {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .skill-chip {
    padding: 6px 16px;
    font-size: 0.82rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.8);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all var(--transition-fast);
  }
  .skill-chip:hover {
    border-color: var(--border-hover);
    color: var(--accent-cyan);
    background: rgba(6, 182, 212, 0.06);
  }

  .tech-icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 16px;
  }
  .tech-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 8px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.4);
    transition: all var(--transition-base);
    text-align: center;
  }
  .tech-icon-item:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    background: rgba(6, 182, 212, 0.04);
  }
  .tech-icon-item img {
    width: 36px;
    height: 36px;
    filter: grayscale(0.2);
    transition: filter var(--transition-fast);
  }
  .tech-icon-item:hover img { filter: grayscale(0); }
  .tech-icon-item span {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .cert-list { display: flex; flex-direction: column; gap: 16px; }
  .cert-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.4);
  }
  .cert-icon { color: var(--accent-cyan); flex-shrink: 0; }
  .cert-item h4 { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); }
  .cert-meta { font-size: 0.8rem; color: var(--text-muted); }

  .edu-list { display: flex; flex-direction: column; gap: 20px; }
  .edu-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .edu-item:last-child { border-bottom: none; }
  .edu-year {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .edu-item h4 { font-size: 1rem; font-weight: 600; margin-top: 4px; color: var(--text-primary); }
  .edu-item p { color: var(--text-secondary); font-size: 0.9rem; margin-top: 2px; }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }
    .about-image { justify-self: center; }
    .image-wrapper { max-width: 200px; }
    .image-wrapper img { aspect-ratio: 1; }
    .tab-buttons {
      flex-direction: row;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      flex-wrap: nowrap;
      gap: 2px;
    }
    .tab-buttons::-webkit-scrollbar { display: none; }
    .tab-btn {
      flex: 0 0 auto;
      padding: 8px 18px;
      font-size: 0.8rem;
    }
    .tech-icon-grid { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
  }
</style>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabBtns.forEach((b) => b.classList.remove('active'));
      tabPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`tab-${target}`)?.classList.add('active');
    });
  });
</script>
