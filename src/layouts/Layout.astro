---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mathinraj Ramasamy — Full Stack Developer & AI Enthusiast",
  description = "Full Stack Developer at Cognizant building scalable web applications with Java, Spring Boot, React, and AI-powered tools. Creator of TouchLock (620+ users) and other published browser extensions."
} = Astro.props;

const ogImage = "/images/og-preview.png";
const siteUrl = "https://mathinraj.is-a.dev";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Mathinraj Ramasamy" />
  <meta name="keywords" content="Mathinraj, Full Stack Developer, Java, React, Spring Boot, Cognizant, AI, Browser Extensions, Portfolio" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="Mathinraj Ramasamy" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="canonical" href={siteUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <slot />

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(el => observer.observe(el));
  </script>
</body>
</html>
