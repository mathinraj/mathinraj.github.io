---
import '../styles/scroll-engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "Mathinraj Ramasamy, full stack engineer",
  description = "Full stack engineer at Cognizant building enterprise fintech in Java, Spring Boot and React. After hours: browser extensions with 936 users, including TouchLock and RepoLens.",
  path = ""
} = Astro.props;

const ogImage = "/images/og-preview.png";
const siteUrl = "https://mathinraj.is-a.dev";
const pageUrl = `${siteUrl}${path}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="author" content="Mathinraj Ramasamy" />
  <meta name="theme-color" content="#eceee8" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="Mathinraj Ramasamy" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Geist:wght@400..600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <slot />
  <div class="grain" aria-hidden="true"></div>

  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('[data-span-reduced]').forEach(function (el) {
        el.setAttribute('data-sc-span', el.getAttribute('data-span-reduced'));
      });
    }
  </script>
  <script is:inline src="/js/scroll-engine.js"></script>
  <script is:inline>ScrollCraft.mount(document.body);</script>
</body>
</html>
